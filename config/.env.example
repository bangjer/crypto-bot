# Copy this file to the project root as `.env` and fill in values.
# NEVER commit the real .env file — it is gitignored.

# --- Binance API (NOT needed for Stage 1 backtesting; public data only) ---
# When you eventually create these keys for Stages 4-5:
#   * enable "Spot & Margin Trading" permission ONLY
#   * DISABLE withdrawal permission in the Binance UI — the bot never needs it
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Fees (fractions, not percent: 0.001 = 0.10%) ---
# Default is Binance spot standard (VIP 0) schedule, no BNB discount.
MAKER_FEE=0.001
TAKER_FEE=0.001

# --- Backtest assumptions ---
# Slippage per fill in basis points (1 bp = 0.01%), applied against you.
SLIPPAGE_BPS=1.0

# Fill model: "taker" (market orders: slippage + taker fee) or
# "maker_optimistic" (limit orders at the signal bar's close: maker fee, no
# slippage). CAVEAT: maker_optimistic has no queue modeling — it assumes every
# price touch fills, so its results are an optimistic bound, not an
# achievable cost.
FILL_MODE=taker

# --- Live trading kill-guard (Stage 5) ---
# Live mode refuses to start unless this is EXACTLY the string "true".
# Leave it false until Stage 4 paper trading has run for a meaningful stretch.
LIVE_TRADING_ENABLED=false
